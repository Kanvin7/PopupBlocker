<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PopupBlocker.Utility\PopupBlocker.Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Core 版 MSBuild 无法解析 COMReference(MSB4803),
         故命令行编译时用 -p:SkipComReference=true 改用已生成好的互操作程序集。
         在 Visual Studio 中不传该开关,行为与原来完全一致。 -->
    <COMReference Include="TaskScheduler" Condition="'$(SkipComReference)' != 'true'">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>e34cb9f1-c7f7-424c-be29-027dcc09363a</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </COMReference>
    <Reference Include="Interop.TaskScheduler" Condition="'$(SkipComReference)' == 'true'">
      <HintPath>lib\Interop.TaskScheduler.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
